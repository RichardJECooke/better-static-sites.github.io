---
export interface SelectorEntry {
  data: {
    version: string;
    date: Date;
    name?: string;
  };
}

export interface Props {
  updates: SelectorEntry[];
}

const { updates } = Astro.props as Props;
---

<div class="release-selector">
  <label for="release-notes-version" class="rn-sr-only">Jump to a release version</label>
  <select
    id="release-notes-version"
    class="release-selector-select"
  >
    <option value="">Jump to a version...</option>
    {updates.map((item) => {
      const versionId = `version-${item.data.version.replaceAll('.', '-')}`;
      const label = `Version ${item.data.version}${item.data.name ? ` (${item.data.name})` : ''}`;
      return <option value={versionId}>{label}</option>;
    })}
  </select>
  <p id="release-notes-version-status" class="rn-sr-only" aria-live="polite"></p>
</div>

<script is:inline>
  const initVersionSpy = () => {
    // each article's anchor id lives on its h2
    const headingId = (article) => article.querySelector('h2[id]')?.id;
    const selectEl = document.getElementById('release-notes-version');
    if (!selectEl) return;

    const placeholderOption = selectEl.querySelector('option[value=""]');
    const statusEl = document.getElementById('release-notes-version-status');
    const versions = Array.from(document.querySelectorAll('article.version')).filter(a => headingId(a));
    if (versions.length === 0) return;

    const HEADER_OFFSET = 210;
    let currentActiveId = null;
    let isTicking = false;
    let hasUserInteracted = false;

    const disablePlaceholder = () => {
      if (placeholderOption && !placeholderOption.disabled) {
        placeholderOption.disabled = true;
        placeholderOption.hidden = true;
      }
    };

    const updateScrollSpy = () => {
      if (window.scrollY === 0 && !hasUserInteracted) return;

      let activeArticle = versions[0];
      for (let i = versions.length - 1; i >= 0; i--) {
        if (versions[i].getBoundingClientRect().top < HEADER_OFFSET) {
          activeArticle = versions[i];
          break;
        }
      }

      if (activeArticle && headingId(activeArticle) !== currentActiveId) {
        currentActiveId = headingId(activeArticle);
        selectEl.value = currentActiveId;
        disablePlaceholder();
      }
    };

    const onScroll = () => {
      if (window.scrollY > 0) hasUserInteracted = true;
      if (!isTicking) {
        window.requestAnimationFrame(() => {
          updateScrollSpy();
          isTicking = false;
        });
        isTicking = true;
      }
    };

    // focus stays on the select (arrow keys fire change on windows), so announce the jump instead
    selectEl.addEventListener('change', () => {
      hasUserInteracted = true;
      disablePlaceholder();
      if (!selectEl.value) return;
      window.location.hash = selectEl.value;
      if (statusEl) statusEl.textContent = `Jumped to ${selectEl.selectedOptions[0]?.textContent ?? selectEl.value}`;
    });

    const filterControls = document.querySelector('.filter-controls');
    if (filterControls) {
      filterControls.addEventListener('change', () => {
        const targetVersion = versions.find(a => headingId(a) === currentActiveId) || versions[0];
        window.requestAnimationFrame(() => {
          if (targetVersion && hasUserInteracted) {
            const adjustment = targetVersion.getBoundingClientRect().top - HEADER_OFFSET;
            window.scrollBy({ top: adjustment, behavior: 'instant' });
          }
          updateScrollSpy();
        });
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    updateScrollSpy();
  };

  document.addEventListener('DOMContentLoaded', initVersionSpy);
  document.addEventListener('astro:page-load', initVersionSpy);
</script>
